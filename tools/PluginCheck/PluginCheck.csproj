<Project Sdk="Microsoft.NET.Sdk">

  <!-- Build-time tool, not in Sleezer.sln: reads metadata only, so it checks a net10.0 Lidarr from the net8.0 SDK. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Sleezer.PluginCheck</RootNamespace>
    <AssemblyName>Sleezer.PluginCheck</AssemblyName>
    <PluginProject>false</PluginProject>
    <OutputPath>bin/$(Configuration)/</OutputPath>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>

</Project>
