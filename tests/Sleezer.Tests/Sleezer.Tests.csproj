<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Run against whatever major runtime is installed (CI has 8, dev boxes may have 10+). -->
    <RollForward>LatestMajor</RollForward>
    <!-- Opt out of Lidarr's Directory.Build.props Test-classification so the test host
         lands in a predictable bin/ path instead of Lidarr's _tests/ output folder. -->
    <LidarrOutputType>Library</LidarrOutputType>
    <!-- Tests pull in a handful of plugin source files directly rather than referencing
         the full Sleezer.csproj, which would drag in ILRepack, DeezNET, and the whole
         Lidarr submodule. Keep this project self-contained so `dotnet test` runs fast. -->
  </PropertyGroup>

  <ItemGroup>
    <None Include="Fixtures\silence.flac" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
    <!-- Same version as Sleezer.csproj — SlskdItemsParser fuzzy matching. -->
    <PackageReference Include="FuzzySharp" Version="2.0.2" />
    <!-- NzbDroneLogger's static initializer needs this at runtime (same version
         as Lidarr.Common); without it any type that logs via NzbDroneLogger
         throws TypeInitializationException under the test host. -->
    <PackageReference Include="NLog.Layouts.ClefJsonLayout" Version="1.0.5" />
    <!-- The scheduler the web download clients run on. Pulled in to pin its completion
         semantics, which is what a post-process pass has to hang off. -->
    <PackageReference Include="Shard.DownloadAssistant" Version="1.1.2" />
    <!-- Same version as Sleezer.csproj — Blowfish for DeezerStreamDecoder. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pull in just the files under test to avoid dragging the full plugin build graph. -->
    <Compile Include="..\..\src\Sleezer\Core\PostProcessing\FeaturedArtistStripper.cs"
             LinkBase="SourceUnderTest" />
    <Compile Include="..\..\src\Sleezer\Core\PostProcessing\FfmpegErrorFormatter.cs"
             LinkBase="SourceUnderTest" />
    <Compile Include="..\..\src\Sleezer\Core\PostProcessing\TrackTitleMatcher.cs"
             LinkBase="SourceUnderTest" />
    <Compile Include="..\..\src\Sleezer\Core\PostProcessing\RecordingVerdict.cs"
             LinkBase="SourceUnderTest" />
    <!-- Claim-vs-reality comparison for issue #85. The TagLib read path is IO;
         only the pure Compare half is exercised here. -->
    <Compile Include="..\..\src\Sleezer\Core\PostProcessing\AudioQualityVerifier.cs"
             LinkBase="SourceUnderTest" />
    <!-- Digital-vs-CD release choice for store downloads (#102). Pure: AlbumRelease
         and Medium come from the Lidarr.Core reference below. -->
    <Compile Include="..\..\src\Sleezer\Core\PostProcessing\DigitalReleaseSelector.cs"
             LinkBase="SourceUnderTest" />
    <!-- Gate on the title fallback that runs when album-level matching fails. -->
    <Compile Include="..\..\src\Sleezer\Core\PostProcessing\TitleFallbackGuard.cs"
             LinkBase="SourceUnderTest" />
    <!-- Which download clients are storefronts, and so can only deliver a digital
         release. Enum + classifier only; the settings class stays out. -->
    <Compile Include="..\..\src\Sleezer\Metadata\FFmpeg\PostProcessClient.cs"
             LinkBase="SourceUnderTest" />
    <Compile Include="..\..\src\Sleezer\Blocklisting\BaseBlocklist.cs"
             LinkBase="SourceUnderTest" />
    <Compile Include="..\..\src\Sleezer\Blocklisting\Blocklists.cs"
             LinkBase="SourceUnderTest" />
    <Compile Include="..\..\src\Sleezer\Blocklisting\DeezerBlocklist.cs"
             LinkBase="SourceUnderTest" />
    <Compile Include="..\..\src\Sleezer\Blocklisting\TidalBlocklist.cs"
             LinkBase="SourceUnderTest" />
    <!-- Provenance tag written after the client's own metadata pass. -->
    <Compile Include="..\..\src\Sleezer\Core\Utilities\SourceTagWriter.cs"
             LinkBase="SourceUnderTest" />
    <Compile Include="..\..\src\Sleezer\Core\Utilities\ReleaseFormatter.cs"
             LinkBase="SourceUnderTest" />
    <!-- Deezer stripe decode; BouncyCastle only. -->
    <Compile Include="..\..\src\Sleezer\Core\Deezer\DeezerStreamDecoder.cs"
             LinkBase="SourceUnderTest" />
    <!-- Identity gate for Deezer track substitution; BCL only. -->
    <Compile Include="..\..\src\Sleezer\Core\Deezer\DeezerFallbackGate.cs"
             LinkBase="SourceUnderTest" />
    <!-- Store-result verification: FuzzySharp + SlskdTextProcessor (both already here) + Lidarr.Core types. -->
    <Compile Include="..\..\src\Sleezer\Core\Model\StoreReleaseInfo.cs"
             LinkBase="SourceUnderTest" />
    <Compile Include="..\..\src\Sleezer\Core\Utilities\StoreQueryCleaner.cs"
             LinkBase="SourceUnderTest" />
    <Compile Include="..\..\src\Sleezer\Core\Utilities\StoreReleaseVerifier.cs"
             LinkBase="SourceUnderTest" />
    <!-- Baseline Deezer tag write; TagLib + Newtonsoft via the Lidarr.Core reference. -->
    <Compile Include="..\..\src\Sleezer\Download\Clients\Deezer\DeezerTagger.cs"
             LinkBase="SourceUnderTest" />
    <Compile Include="..\..\src\Sleezer\Core\Tidal\TidalPathSanitizer.cs"
             LinkBase="SourceUnderTest" />
    <Compile Include="..\..\src\Sleezer\Core\Tidal\TidalArtistMatcher.cs"
             LinkBase="SourceUnderTest" />
    <!-- Deezer path templating: guards the delegation to TidalPathSanitizer, without
         which Linux leaves ':' and '\' in download paths. Newtonsoft only. -->
    <Compile Include="..\..\src\Sleezer\Download\Clients\Deezer\MetadataUtilities.cs"
             LinkBase="SourceUnderTest" />
    <Compile Include="..\..\src\Sleezer\Core\Qobuz\QobuzURL.cs"
             LinkBase="SourceUnderTest" />
    <!-- Slskd retry-exhaustion state machine and its transitive deps. Lidarr.Core
         supplies DownloadItemStatus via the project reference below. -->
    <Compile Include="..\..\src\Sleezer\Download\Clients\Soulseek\Models\SlskdFileState.cs"
             LinkBase="SourceUnderTest" />
    <Compile Include="..\..\src\Sleezer\Download\Clients\Soulseek\Models\SlskdDownloadFile.cs"
             LinkBase="SourceUnderTest" />
    <Compile Include="..\..\src\Sleezer\Indexers\Soulseek\SlsdkRecords.cs"
             LinkBase="SourceUnderTest" />
    <Compile Include="..\..\src\Sleezer\Core\Utilities\AudioFormat.cs"
             LinkBase="SourceUnderTest" />
    <!-- Same-title album collision guard (#105). ReleaseInfo and AlbumSearchCriteria
         come from the Lidarr.Core reference below. -->
    <Compile Include="..\..\src\Sleezer\Core\Utilities\AlbumYearGuard.cs"
             LinkBase="SourceUnderTest" />
    <Compile Include="..\..\src\Sleezer\Core\Utilities\DirectoryEmptiness.cs"
             LinkBase="SourceUnderTest" />
    <Compile Include="..\..\src\Sleezer\Core\Utilities\EmptyDownloadDirectorySweeper.cs"
             LinkBase="SourceUnderTest" />
    <!-- Pure ffmpeg-release helpers (platform→asset map, version/tag parse, 24h
         throttle, SHA-256 verify). BCL-only, so it compiles standalone here. -->
    <Compile Include="..\..\src\Sleezer\Core\Model\FFmpegRelease.cs"
             LinkBase="SourceUnderTest" />
    <!-- Pure helper — depends only on Newtonsoft.Json (transitively pulled in via
         the Lidarr.Core ProjectReference below). -->
    <Compile Include="..\..\src\Sleezer\TidalSharp\ExpiredTokenDetector.cs"
             LinkBase="SourceUnderTest" />
    <!-- Lossless-tier guard for Tidal silent codec downgrade detection.
         Pulls in the AudioQuality enum from Quality.cs as its only dep. -->
    <!-- Tidal's ffmpeg wrapper. BCL-only, and the only client that shells out during a
         download, so its binary resolution is pinned here. -->
    <!-- Import-vs-post-process ordering gate. BCL + Lidarr's DownloadItemStatus only. -->
    <Compile Include="..\..\src\Sleezer\Core\Download\IQueuedDownload.cs"
             LinkBase="SourceUnderTest" />
    <Compile Include="..\..\src\Sleezer\Core\Download\PostProcessGate.cs"
             LinkBase="SourceUnderTest" />
    <Compile Include="..\..\src\Sleezer\Download\Clients\Tidal\FFMPEG.cs"
             LinkBase="SourceUnderTest" />
    <Compile Include="..\..\src\Sleezer\TidalSharp\LosslessGuard.cs"
             LinkBase="SourceUnderTest" />
    <Compile Include="..\..\src\Sleezer\TidalSharp\Data\Quality.cs"
             LinkBase="SourceUnderTest" />
    <!-- Slskd search/matching units (2026-07 audit fixes) and their deps. -->
    <Compile Include="..\..\src\Sleezer\Indexers\DownloadProtocols.cs"
             LinkBase="SourceUnderTest" />
    <Compile Include="..\..\src\Sleezer\Indexers\Soulseek\SlskdTextProcessor.cs"
             LinkBase="SourceUnderTest" />
    <Compile Include="..\..\src\Sleezer\Core\Utilities\VariantQualifiers.cs"
             LinkBase="SourceUnderTest" />
    <Compile Include="..\..\src\Sleezer\Core\DecisionEngine\StoreMatchSpecification.cs"
             LinkBase="SourceUnderTest" />
    <Compile Include="..\..\src\Sleezer\Core\Model\IVerifiableRelease.cs"
             LinkBase="SourceUnderTest" />
    <Compile Include="..\..\src\Sleezer\Download\Clients\Deezer\DeezerSchema.cs"
             LinkBase="SourceUnderTest" />
    <Compile Include="..\..\src\Sleezer\Core\Deezer\DeezerTrackRights.cs"
             LinkBase="SourceUnderTest" />
    <Compile Include="..\..\src\Sleezer\Core\Deezer\DeezerSearchResponseReader.cs"
             LinkBase="SourceUnderTest" />
    <Compile Include="..\..\src\Sleezer\Indexers\Soulseek\SlskdItemsParser.cs"
             LinkBase="SourceUnderTest" />
    <Compile Include="..\..\src\Sleezer\Indexers\Soulseek\ISlskdItemsParser.cs"
             LinkBase="SourceUnderTest" />
    <Compile Include="..\..\src\Sleezer\Indexers\Soulseek\SlskdSettings.cs"
             LinkBase="SourceUnderTest" />
    <Compile Include="..\..\src\Sleezer\Indexers\Soulseek\SlskdUrls.cs"
             LinkBase="SourceUnderTest" />
    <Compile Include="..\..\src\Sleezer\Indexers\Soulseek\Search\Core\SearchContext.cs"
             LinkBase="SourceUnderTest" />
    <Compile Include="..\..\src\Sleezer\Indexers\Soulseek\Search\Templates\TemplateEngine.cs"
             LinkBase="SourceUnderTest" />
    <Compile Include="..\..\src\Sleezer\Indexers\Soulseek\Search\Transformers\QueryNormalizer.cs"
             LinkBase="SourceUnderTest" />
    <Compile Include="..\..\src\Sleezer\Indexers\Soulseek\Search\Transformers\QueryBuilder.cs"
             LinkBase="SourceUnderTest" />
    <Compile Include="..\..\src\Sleezer\Core\Model\AlbumData.cs"
             LinkBase="SourceUnderTest" />
    <Compile Include="..\..\src\Sleezer\Core\Model\ShareInfo.cs"
             LinkBase="SourceUnderTest" />
    <Compile Include="..\..\src\Sleezer\Download\Clients\Soulseek\Models\SlskdDownloadItem.cs"
             LinkBase="SourceUnderTest" />
    <Compile Include="..\..\src\Sleezer\Download\Clients\Soulseek\Models\SlskdDownloadDirectory.cs"
             LinkBase="SourceUnderTest" />
    <Compile Include="..\..\src\Sleezer\Download\Clients\Soulseek\SlskdPathResolver.cs"
             LinkBase="SourceUnderTest" />
    <Compile Include="..\..\src\Sleezer\Download\Clients\Soulseek\SlskdDirectoryPartitioner.cs"
             LinkBase="SourceUnderTest" />
    <Compile Include="..\..\src\Sleezer\Download\Clients\Soulseek\SlskdStatusResolver.cs"
             LinkBase="SourceUnderTest" />
    <!-- Watchdog cancel path. Only the API *interface* is pulled in (tests fake it),
         so no HTTP client machinery follows; settings supply the bailout thresholds. -->
    <Compile Include="..\..\src\Sleezer\Download\Clients\Soulseek\SlskdWatchdog.cs"
             LinkBase="SourceUnderTest" />
    <Compile Include="..\..\src\Sleezer\Download\Clients\Soulseek\ISlskdApiClient.cs"
             LinkBase="SourceUnderTest" />
    <Compile Include="..\..\src\Sleezer\Download\Clients\Soulseek\SlskdProviderSettings.cs"
             LinkBase="SourceUnderTest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Needed for NzbDrone.Core.Download.DownloadItemStatus. Same submodule the
         main plugin already references; tests build against the identical types. -->
    <ProjectReference Include="..\..\ext\Lidarr\src\NzbDrone.Core\Lidarr.Core.csproj" />
  </ItemGroup>

</Project>
